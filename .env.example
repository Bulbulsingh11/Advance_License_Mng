# GEMINI_API_KEY: Required for Gemini AI DGFT document extraction.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# SUPABASE CONFIGURATION:
# SUPABASE_URL / VITE_SUPABASE_URL: The Project URL found in your Supabase project settings -> API.
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# SUPABASE_SERVICE_KEY / SUPABASE_SERVICE_ROLE_KEY: The secret service_role key used server-side in server.ts.
# WARNING: Keep this secret; never expose in client code.
SUPABASE_SERVICE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_SUPABASE_ANON_KEY: The public anon key found in your Supabase project settings -> API.
VITE_SUPABASE_ANON_KEY=""
